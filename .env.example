# Database Configuration
DATABASE_URL=postgresql://recengine:recengine_password@postgres:5432/recommendation_db

# Redis Configuration
REDIS_URL=redis://redis:6379
CACHE_TTL=300

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPICS_PREFIX=rec_events

# Qdrant Vector Database
QDRANT_URL=http://qdrant:6333
EMBEDDING_DIMENSION=512

# MLflow Model Registry
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_REGISTRY_NAME=recommendation_model

# Feature Store Configuration
FEAST_OFFLINE_STORE=parquet
FEAST_ONLINE_STORE=redis

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Recommendation Engine
VERSION=1.0.0

# AWS Configuration (for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
